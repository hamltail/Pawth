- if !posted_today
  = link_to new_daily_post_path,
            data: { turbo_frame: 'modal' },
            class: 'cta-button px-3 py-1.5 text-sm md:px-4 md:py-2 md:text-base' do
    %svg{
      class: 'w-4 h-4 md:w-5 md:h-5',
      fill: 'none',
      stroke: 'currentColor',
      viewBox: '0 0 24 24',
      aria: { hidden: 'true' }
    }
      %path{ d: 'M6 3.75A2.25 2.25 0 0 1 8.25 1.5h7.5A2.25 2.25 0 0 1 18 3.75v16.5a.75.75 0 0 1-1.14.64L12 18.02l-4.86 2.87A.75.75 0 0 1 6 20.25V3.75Z', 'stroke-width': '1.5', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
      %path{ d: 'M9 6.75h6M9 10.5h6M9 14.25h3.75', 'stroke-width': '1.5', 'stroke-linecap': 'round' }
      %path{ d: 'm15.75 13.5 2.25 2.25M17.36 12.64l.75-.75a1.06 1.06 0 0 1 1.5 1.5l-.75.75-4.24 4.24-2.12.62.62-2.12 4.24-4.24Z', 'stroke-width': '1.5', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
    %span= t('daily_posts.index.new_button')

- else
  %button.inline-flex.items-center.gap-2.bg-surface-muted.text-muted.font-bold.rounded-full.cursor-not-allowed.ring-1.ring-default-border{
    class: 'px-3 py-1.5 text-sm md:px-4 md:py-2 md:text-base',
    disabled: true,
    aria: { disabled: true }
  }
    %svg{
      class: 'w-4 h-4 md:w-5 md:h-5',
      fill: 'none',
      stroke: 'currentColor',
      viewBox: '0 0 24 24',
      aria: { hidden: 'true' }
    }
      %path{ d: 'M6 3.75A2.25 2.25 0 0 1 8.25 1.5h7.5A2.25 2.25 0 0 1 18 3.75v16.5a.75.75 0 0 1-1.14.64L12 18.02l-4.86 2.87A.75.75 0 0 1 6 20.25V3.75Z', 'stroke-width': '1.5', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
      %path{ d: 'M9 6.75h6M9 10.5h6M9 14.25h3.75', 'stroke-width': '1.5', 'stroke-linecap': 'round' }
      %path{ d: 'm15.75 13.5 2.25 2.25M17.36 12.64l.75-.75a1.06 1.06 0 0 1 1.5 1.5l-.75.75-4.24 4.24-2.12.62.62-2.12 4.24-4.24Z', 'stroke-width': '1.5', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
    %span= t('daily_posts.index.new_button')

- button_label = t('daily_posts.index.new_button')
- status_label = posted_today ? t('daily_posts.index.posted_today_message') : button_label

- if !posted_today
  = link_to new_daily_post_path,
            data: { turbo_frame: 'modal' },
            class: 'new-post-action cta-button px-3 py-1.5 text-sm md:px-4 md:py-2 md:text-base' do
    = render 'shared/icon_new_post', klass: 'w-5 h-5 shrink-0'

    %span.new-post-label= button_label

- else
  %button.new-post-action.inline-flex.items-center.gap-2.bg-surface-muted.text-muted.font-bold.rounded-full.cursor-not-allowed.ring-1.ring-default-border{
    class: 'px-3 py-1.5 text-sm md:px-4 md:py-2 md:text-base',
    type: 'button',
    disabled: true,
    aria: {
      disabled: true,
      label: status_label
    }
  }
    = render 'shared/icon_new_post', klass: 'w-5 h-5 shrink-0'

    %span.new-post-label= button_label

%span.new-post-tooltip{
  class: 'pointer-events-none absolute right-0 top-full z-50 mt-2 hidden whitespace-nowrap rounded-lg border border-default-border bg-surface px-3 py-2 text-xs font-semibold text-primary shadow-lg max-[85.999rem]:group-hover:block max-[85.999rem]:group-focus-within:block',
  aria: { hidden: 'true' }
}= status_label

- if post.present?
  .relative.mb-6{
    data: {
      controller: 'post-navigator',
      action: 'pointerdown->post-navigator#handlePointerDown pointerup->post-navigator#handlePointerUp pointercancel->post-navigator#handlePointerCancel'
    }
  }
    .flex.items-center{ class: 'gap-1 md:gap-2' }
      %button.flex.shrink-0.items-center.justify-center.h-10.text-muted.hover:text-primary.disabled:opacity-25.disabled:cursor-not-allowed.disabled:hover:text-muted.transition-colors{
        class: 'w-7 md:w-10',
        type: 'button',
        aria: { label: '前の日記' },
        data: {
          post_navigator_target: 'prevButton',
          action: 'click->post-navigator#previous'
        }
      }
        %div{ class: 'md:hidden' }
          = render 'shared/icon_arrow', direction: 'left', klass: 'w-4 h-4'

        %div{ class: 'hidden md:block' }
          = render 'shared/icon_arrow', direction: 'left', klass: 'w-5 h-5'

      .daily-post-card.relative.flex.flex-1.min-w-0.flex-col.overflow-hidden.rounded-2xl.p-5.bg-surface.shadow-sm.ring-1.ring-default-border{
        class: 'h-72 md:h-64 xl:h-[28rem]',
        data: {
          post_navigator_target: 'card'
        }
      }
        .shrink-0
          .inline-flex.items-center.gap-2.rounded-full.bg-surface-muted.px-3.py-1.font-semibold.text-secondary-text{
            class: 'text-[10px] md:text-xs'
          }
            %span#daily-post-date= post.posted_on

        #daily-post-content.daily-post-scroll.mt-3.min-h-0.flex-1.overflow-y-auto.leading-relaxed.text-primary.whitespace-pre-wrap.break-words{
          class: 'text-sm md:text-base'
        }= h(post.content)

      %button.flex.shrink-0.items-center.justify-center.h-10.text-muted.hover:text-primary.disabled:opacity-25.disabled:cursor-not-allowed.disabled:hover:text-muted.transition-colors{
        class: 'w-7 md:w-10',
        type: 'button',
        aria: { label: '次の日記' },
        data: {
          post_navigator_target: 'nextButton',
          action: 'click->post-navigator#next'
        }
      }
        %div{ class: 'md:hidden' }
          = render 'shared/icon_arrow', direction: 'right', klass: 'w-4 h-4'

        %div{ class: 'hidden md:block' }
          = render 'shared/icon_arrow', direction: 'right', klass: 'w-5 h-5'

- else
  .mb-6.rounded-2xl.p-6.bg-surface-muted.text-muted.text-center.ring-1.ring-default-border
    = t('activities.current_post.empty')

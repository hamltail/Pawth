- if post.present?
  .relative.mb-6{
    data: {
      controller: 'post-navigator',
      action: 'pointerdown->post-navigator#handlePointerDown pointerup->post-navigator#handlePointerUp pointercancel->post-navigator#handlePointerCancel'
    }
  }
    .flex.items-start.gap-2
      %button.flex.shrink-0.items-center.justify-center.w-10.h-10.text-muted.hover:text-primary.disabled:opacity-25.disabled:cursor-not-allowed.disabled:hover:text-muted.transition-colors{
        type: 'button',
        aria: { label: '前の日記' },
        data: {
          post_navigator_target: 'prevButton',
          action: 'click->post-navigator#previous'
        }
      }
        = render 'shared/icon_arrow', direction: 'left', klass: 'w-5 h-5'

      .daily-post-card.relative.flex.flex-1.min-w-0.flex-col.overflow-hidden.rounded-2xl.p-5.bg-surface.shadow-sm.ring-1.ring-default-border.hover:-translate-y-1.hover:shadow-lg.active:translate-y-1.active:scale-x-105.active:scale-y-90{
        class: 'h-64 xl:h-[28rem] transform transition-transform duration-350 ease-[cubic-bezier(0.34,2.2,0.64,1)]'
      }
        .shrink-0
          .inline-flex.items-center.gap-2.rounded-full.bg-surface-muted.px-3.py-1.text-xs.font-semibold.text-secondary-text
            %span#daily-post-date= post.posted_on

        #daily-post-content.daily-post-scroll.mt-3.min-h-0.flex-1.overflow-y-auto.leading-relaxed.text-primary.whitespace-pre-wrap.break-words
          = h(post.content)

      %button.flex.shrink-0.items-center.justify-center.w-10.h-10.text-muted.hover:text-primary.disabled:opacity-25.disabled:cursor-not-allowed.disabled:hover:text-muted.transition-colors{
        type: 'button',
        aria: { label: '次の日記' },
        data: {
          post_navigator_target: 'nextButton',
          action: 'click->post-navigator#next'
        }
      }
        = render 'shared/icon_arrow', direction: 'right', klass: 'w-5 h-5'

- else
  .mb-6.rounded-2xl.p-6.bg-surface-muted.text-muted.text-center.ring-1.ring-default-border
    = t('activities.current_post.empty')

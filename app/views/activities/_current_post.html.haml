- if post.present?
  .relative.mb-6{
    data: {
      controller: 'post-navigator',
      action: 'pointerdown->post-navigator#handlePointerDown pointerup->post-navigator#handlePointerUp pointercancel->post-navigator#handlePointerCancel'
    }
  }
    .daily-post-card{
      class: 'relative flex w-full min-w-0 flex-col overflow-hidden rounded-2xl bg-surface p-4 md:p-5 shadow-sm ring-1 ring-default-border h-72 md:h-64 min-[86rem]:h-auto min-[86rem]:min-h-[28rem] min-[86rem]:max-h-[calc(100dvh-21rem)]',
      data: {
        post_navigator_target: 'card'
      }
    }
      %div{
        class: 'flex shrink-0 items-center justify-between gap-2 border-b border-default-border pb-2 md:pb-3',
        data: {
          controller: 'daily-post-date'
        }
      }
        %button{
          class: 'flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-surface-muted text-muted transition-colors hover:bg-brand/10 hover:text-brand disabled:cursor-not-allowed disabled:opacity-25 disabled:hover:bg-surface-muted disabled:hover:text-muted',
          type: 'button',
          aria: { label: '前の日記' },
          data: {
            post_navigator_target: 'prevButton',
            action: 'click->post-navigator#previous'
          }
        }
          = render 'shared/icon_arrow', direction: 'left', klass: 'scale-75'

        %div{ class: 'min-w-0 flex-1 text-center' }
          %span#daily-post-date{
            class: 'sr-only',
            aria: { hidden: 'true' },
            data: { daily_post_date_target: 'raw' }
          }= post.posted_on.iso8601

          %div{
            class: 'text-[9px] md:text-xs font-semibold tracking-widest text-muted',
            data: { daily_post_date_target: 'month' }
          }= post.posted_on.strftime('%B %Y').upcase

          %div{ class: 'mt-0.5 md:mt-1 flex items-baseline justify-center gap-1 md:gap-2' }
            %time.calendar-month-glow{
              class: 'text-2xl md:text-3xl font-bold text-primary',
              datetime: post.posted_on.iso8601,
              data: { daily_post_date_target: 'day' }
            }= post.posted_on.day

            %span{
              class: "text-xs md:text-sm font-bold #{calendar_day_color_class(post.posted_on, weekday_class: 'theme-link')}",
              data: { daily_post_date_target: 'weekday' }
            }= post.posted_on.strftime('%a').upcase

        %button{
          class: 'flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-surface-muted text-muted transition-colors hover:bg-brand/10 hover:text-brand disabled:cursor-not-allowed disabled:opacity-25 disabled:hover:bg-surface-muted disabled:hover:text-muted',
          type: 'button',
          aria: { label: '次の日記' },
          data: {
            post_navigator_target: 'nextButton',
            action: 'click->post-navigator#next'
          }
        }
          = render 'shared/icon_arrow', direction: 'right', klass: 'scale-75'

      #daily-post-content{
        class: 'daily-post-scroll mt-3 md:mt-4 min-h-0 flex-1 overflow-y-auto whitespace-pre-wrap break-words text-sm leading-relaxed text-primary md:text-base'
      }= h(post.content)

- else
  %div{
    class: 'mb-6 rounded-2xl bg-surface-muted p-6 text-center text-muted ring-1 ring-default-border'
  }
    = t('activities.current_post.empty')

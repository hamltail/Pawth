- if post.present?
  .daily-post-card.relative.mb-6.rounded-2xl.p-5.bg-white.shadow-sm.ring-1.ring-gray-300.transition.transform.hover:-translate-y-1.hover:shadow-lg
    .inline-flex.items-center.gap-2.rounded-full.bg-gray-100.px-3.py-1.text-xs.font-semibold.text-gray-600
      %span#daily-post-date= post.posted_on
    .mt-3.leading-relaxed.text-gray-800.whitespace-pre-wrap.break-words#daily-post-content= h(post.content)
- else
  .mb-6.rounded-2xl.p-6.bg-gray-50.text-gray-400.text-center.ring-1.ring-gray-100
    = t('activities.show.no_posts')

- if post.present?
  .relative.mb-6{
    data: {
      controller: 'post-navigator',
      action: 'pointerdown->post-navigator#handlePointerDown pointerup->post-navigator#handlePointerUp pointercancel->post-navigator#handlePointerCancel'
    }
  }
    .flex.items-start.gap-2
      %button.flex.shrink-0.items-center.justify-center.w-10.h-10.text-gray-400.transition-colors{
        type: 'button',
        aria: { label: '前の日記' },
        data: {
          post_navigator_target: 'prevButton',
          action: 'click->post-navigator#previous'
        }
      }
        = render 'shared/icon_arrow', direction: 'left', klass: 'w-5 h-5'

      .daily-post-card.relative.flex-1.min-w-0.rounded-2xl.p-5.bg-white.shadow-sm.ring-1.ring-gray-300.hover:-translate-y-1.hover:shadow-lg.active:translate-y-1.active:scale-x-105.active:scale-y-90{
        class: 'transform transition-transform duration-350 ease-[cubic-bezier(0.34,2.2,0.64,1)]'
      }
        .inline-flex.items-center.gap-2.rounded-full.bg-gray-100.px-3.py-1.text-xs.font-semibold.text-gray-600
          %span#daily-post-date= post.posted_on

        .mt-3.leading-relaxed.text-gray-800.whitespace-pre-wrap.break-words#daily-post-content= h(post.content)

      %button.flex.shrink-0.items-center.justify-center.w-10.h-10.text-gray-400.transition-colors{
        type: 'button',
        aria: { label: '次の日記' },
        data: {
          post_navigator_target: 'nextButton',
          action: 'click->post-navigator#next'
        }
      }
        = render 'shared/icon_arrow', direction: 'right', klass: 'w-5 h-5'

- else
  .mb-6.rounded-2xl.p-6.bg-gray-50.text-gray-400.text-center.ring-1.ring-gray-100
    = t('activities.current_post.empty')

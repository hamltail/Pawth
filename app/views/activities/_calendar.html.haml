#calendar{
  class: 'mb-2 select-none text-primary lg:mb-8',
  data: {
    controller: 'calendar',
    action: 'mouseover->calendar#handleMouseover mouseout->calendar#handleMouseout click->calendar#handleClick pointerdown->calendar#handlePointerDown pointerup->calendar#handlePointerUp pointercancel->calendar#handlePointerCancel'
  }
}
  - meta = calendar_meta(calendar_days)

  %div{
    class: 'calendar-shell mx-auto w-full max-w-[clamp(14rem,calc(58.333dvh_-_8rem),34rem)] lg:max-w-[34rem]'
  }
    .flex.items-center.justify-center.mb-3.lg:mb-8
      = link_to activity_path(username: user.username, year: prev_month.year, month: prev_month.month),
                class: 'flex size-9 shrink-0 items-center justify-center rounded-full bg-surface-muted text-muted transition-colors hover:bg-brand/10 hover:text-brand focus-visible:bg-brand/10 focus-visible:text-brand md:size-11',
                data: { calendar_target: 'prevLink' },
                aria: { label: t('activities.calendar.prev_month') } do
        = render 'shared/icon_arrow', direction: 'left', klass: 'scale-75'

      %h2.mx-3.lg:mx-4.flex-1.flex.items-baseline.justify-center.gap-3.lg:gap-5{ aria: { live: 'polite' } }
        %span.calendar-month-glow.text-4xl.lg:text-5xl.font-bold.text-primary
          = meta[:month_number]

        %span.text-base.lg:text-lg.font-semibold.text-muted
          = meta[:month_year_label]

      = link_to activity_path(username: user.username, year: next_month.year, month: next_month.month),
                class: 'flex size-9 shrink-0 items-center justify-center rounded-full bg-surface-muted text-muted transition-colors hover:bg-brand/10 hover:text-brand focus-visible:bg-brand/10 focus-visible:text-brand md:size-11',
                data: { calendar_target: 'nextLink' },
                aria: { label: t('activities.calendar.next_month') } do
        = render 'shared/icon_arrow', direction: 'right', klass: 'scale-75'

    .grid.grid-cols-7.gap-1.lg:gap-2.justify-center.mb-2.lg:mb-4
      - meta[:weekdays].each_with_index do |wd, index|
        - weekday_class = index == 5 ? 'calendar-saturday' : (index == 6 ? 'calendar-sunday' : 'text-secondary-text')
        %div{ class: "text-xs font-bold text-center #{weekday_class}" }= wd

    %div{
      class: 'calendar-days-grid grid grid-cols-7 gap-x-1 gap-y-2 lg:gap-2 lg:auto-rows-[4rem]'
    }
      - meta[:leading_empty].times do
        %div

      - calendar_days.each do |date|
        - post = post_for(date, posts_by_day)
        - is_today = calendar_today?(date)
        - date_class = calendar_day_color_class(date)
        - date_class = 'calendar-today-date font-extrabold text-emerald-700 in-data-[theme=dark]:text-emerald-300' if is_today

        %div{ class: day_cell_classes(date) }
          %span{
            class: "text-xs leading-none #{date_class}",
            style: (is_today ? 'text-shadow: 0 0 4px rgba(52,211,153,0.95), 0 0 10px rgba(16,185,129,0.8), 0 0 18px rgba(16,185,129,0.4);' : nil),
            aria: (is_today ? { current: 'date' } : {})
          }= date.day

          = calendar_mark_for(date, post, icon: user.profile.calendar_icon)

          - if is_today
            = today_badge

      - meta[:trailing_empty].times do
        %div

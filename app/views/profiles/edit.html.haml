.bg-surface.shadow-md.rounded-lg.px-8.py-8.ring-1.ring-default-border.relative.overflow-hidden
  - has_avatar = @profile.avatar.attached? && @profile.avatar.blob&.persisted?

  - if has_avatar
    %div{ class: 'pointer-events-none absolute right-6 bottom-24 aspect-square w-2/3 lg:top-6 lg:bottom-6 lg:w-auto opacity-25', aria: { hidden: 'true' } }
      = image_tag @profile.avatar,
                  alt: '',
                  class: 'h-full w-full object-cover'

  .relative.z-10
    %h2.text-2xl.font-bold.text-primary.mb-8.text-center= t('profiles.edit.title')

    = form_with model: @profile, url: profile_path, method: :put, html: { multipart: true } do |f|
      - if @profile.errors.any?
        .status-error.border.px-4.py-4.rounded.mb-6
          %p.font-bold= t('shared.errors.title', count: @profile.errors.count)
          %ul.ml-4.list-disc
            - priority = [:avatar, :display_name]
            - sorted_errors = @profile.errors.messages.sort_by { |k, _| priority.index(k) }
            - sorted_errors.each do |attribute, messages|
              - messages.each do |msg|
                %li= @profile.class.human_attribute_name(attribute) + msg

      .mb-4{ data: { controller: 'avatar-preview' } }
        = f.label :avatar, t('activerecord.attributes.profile.avatar'), class: 'block text-secondary-text mb-2'

        - default_src = asset_path('default_avatar.png')

        %img.mt-2.mb-3.aspect-square.shrink-0.rounded-full.w-24.h-24.object-cover#avatar-preview{
          src: (has_avatar ? url_for(@profile.avatar) : default_src),
          alt: t('activerecord.attributes.profile.avatar'),
          data: { avatar_preview_target: 'img', default_src: default_src }
        }

        = f.file_field :avatar,
                       id: 'avatar-input',
                       data: { avatar_preview_target: 'input',
                               action: 'change->avatar-preview#update' },
                       class: 'sr-only'

        %label.inline-flex.items-center.gap-2.bg-brand.hover:bg-brand-light.text-white.font-bold.py-2.px-4.rounded-full.cursor-pointer{
          for: 'avatar-input'
        }
          %svg.w-5.h-5{ fill: 'none', stroke: 'currentColor', viewBox: '0 0 24 24', aria: { hidden: 'true' } }
            %path{
              d: 'm8.25 12.75 6.88-6.88a3 3 0 1 1 4.24 4.24l-8.66 8.66a4.5 4.5 0 0 1-6.36-6.36l8.31-8.31',
              'stroke-width': '1.5',
              'stroke-linecap': 'round',
              'stroke-linejoin': 'round'
            }
          %span ファイルを選択

        %p.text-sm.text-secondary-text.opacity-80.mt-2= t('profiles.edit.avatar_hint')

        - if @profile.errors[:avatar].any?
          %p.field-error.text-sm.mt-1= @profile.errors.full_messages_for(:avatar).first

      .mb-4
        = f.label :display_name, t('activerecord.attributes.profile.display_name'), class: 'block text-secondary-text mb-1'

        = f.text_field :display_name,
                       class: 'border border-default-border bg-surface/50 text-primary placeholder:text-muted rounded w-full max-w-56 px-3 py-2'

      .mb-4
        = f.label :calendar_icon, t('profiles.edit.calendar_icon_label'), class: 'block text-secondary-text mb-2'

        .flex.gap-3
          %label.relative.cursor-pointer
            = f.radio_button :calendar_icon, 'paw', class: 'sr-only peer'

            %div{ class: 'flex items-center justify-center w-20 h-16 rounded-xl bg-surface-muted/50 ring-1 ring-default-border transition-all duration-200 hover:ring-2 hover:ring-brand peer-checked:ring-2 peer-checked:ring-brand' }
              = render 'shared/paw',
                       klass: '',
                       grad: true

            .absolute.-top-2.-right-2.hidden.w-6.h-6.items-center.justify-center.rounded-full.bg-brand.text-white.shadow-sm.peer-checked:flex
              %svg.w-4.h-4{
                fill: 'none',
                stroke: 'currentColor',
                viewBox: '0 0 24 24',
                aria: { hidden: 'true' }
              }
                %path{
                  d: 'M5 12.5 9.5 17 19 7.5',
                  'stroke-width': '2.5',
                  'stroke-linecap': 'round',
                  'stroke-linejoin': 'round'
                }

          %label.relative.cursor-pointer
            = f.radio_button :calendar_icon, 'star', class: 'sr-only peer'

            %div{ class: 'flex items-center justify-center w-20 h-16 rounded-xl bg-surface-muted/50 ring-1 ring-default-border transition-all duration-200 hover:ring-2 hover:ring-brand peer-checked:ring-2 peer-checked:ring-brand' }
              = render 'shared/star',
                       klass: '',
                       grad: true

            .absolute.-top-2.-right-2.hidden.w-6.h-6.items-center.justify-center.rounded-full.bg-brand.text-white.shadow-sm.peer-checked:flex
              %svg.w-4.h-4{
                fill: 'none',
                stroke: 'currentColor',
                viewBox: '0 0 24 24',
                aria: { hidden: 'true' }
              }
                %path{
                  d: 'M5 12.5 9.5 17 19 7.5',
                  'stroke-width': '2.5',
                  'stroke-linecap': 'round',
                  'stroke-linejoin': 'round'
                }

      .mb-4.public-posts-toggle{ data: { controller: 'public-posts-toggle' } }
        = f.label :public_posts, t('profiles.edit.public_posts_label'), class: 'block text-secondary-text mb-1'

        .flex.items-center
          = f.check_box :public_posts,
                        class: 'sr-only',
                        id: 'toggle-public-profile',
                        data: { public_posts_toggle_target: 'checkbox',
                                action: 'change->public-posts-toggle#render' }

          %label.relative.inline-block{ for: 'toggle-public-profile' }
            %span.public-posts-toggle-bar.block.w-16.h-8.rounded-full.ring-1.ring-default-border

            %span.public-posts-toggle-dot.absolute.left-0.top-0.w-8.h-8.rounded-full.shadow-md

          %span.public-posts-private-label.ml-2
            = t('profiles.edit.private')

          %span.public-posts-public-label.ml-2
            = t('profiles.edit.public')

      .mt-6.flex.justify-center
        = f.button type: 'submit', class: 'inline-flex items-center gap-2 bg-brand hover:bg-brand-light text-white font-bold py-2 px-6 rounded-full' do
          %svg.w-5.h-5{
            fill: 'none',
            stroke: 'currentColor',
            viewBox: '0 0 24 24',
            aria: { hidden: 'true' }
          }
            %path{
              d: 'M20 11a8 8 0 1 0-2.34 5.66',
              'stroke-width': '1.5',
              'stroke-linecap': 'round',
              'stroke-linejoin': 'round'
            }
            %path{
              d: 'M20 5.5V11h-5.5',
              'stroke-width': '1.5',
              'stroke-linecap': 'round',
              'stroke-linejoin': 'round'
            }
          %span= t('profiles.edit.update')

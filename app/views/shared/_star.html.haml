:ruby
  klass ||= ''
  dataset ||= {}
  grad ||= false

%svg.calendar-mark{
  xmlns: 'http://www.w3.org/2000/svg',
  viewBox: '0 0 64 64',
  aria: { hidden: 'true' },
  class: "w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 #{klass}",
  data: dataset
}
  %defs
    %lineargradient#star-gradient{
      x1: '12%',
      y1: '8%',
      x2: '88%',
      y2: '92%'
    }
      %stop{ offset: '0%', 'stop-color' => '#fff7a8' }
      %stop{ offset: '28%', 'stop-color' => '#fde047' }
      %stop{ offset: '58%', 'stop-color' => '#fbbf24' }
      %stop{ offset: '82%', 'stop-color' => '#fb923c' }
      %stop{ offset: '100%', 'stop-color' => '#f472b6' }

    %lineargradient#star-border-gradient{
      x1: '0%',
      y1: '0%',
      x2: '100%',
      y2: '100%'
    }
      %stop{ offset: '0%', 'stop-color' => '#fff7c2' }
      %stop{ offset: '45%', 'stop-color' => '#facc15' }
      %stop{ offset: '100%', 'stop-color' => '#f97316' }

  - if grad
    / 外側の星形ライン
    %path{
      d: 'M32 3.5 L40.2 21.1 L59.4 23.4 L45.2 36.5 L49 55.5 L32 46 L15 55.5 L18.8 36.5 L4.6 23.4 L23.8 21.1 Z',
      fill: 'none',
      stroke: 'url(#star-border-gradient)',
      'stroke-width' => '3',
      'stroke-linejoin' => 'round'
    }

    / 内側の星
    %path{
      d: 'M32 9.5 L38.5 23.5 L53.8 25.3 L42.5 35.7 L45.5 50.8 L32 43.2 L18.5 50.8 L21.5 35.7 L10.2 25.3 L25.5 23.5 Z',
      fill: 'url(#star-gradient)',
      stroke: '#f59e0b',
      'stroke-width' => '1.2',
      'stroke-linejoin' => 'round'
    }

  - else
    %path{
      d: 'M32 3.5 L40.2 21.1 L59.4 23.4 L45.2 36.5 L49 55.5 L32 46 L15 55.5 L18.8 36.5 L4.6 23.4 L23.8 21.1 Z',
      fill: 'none',
      stroke: 'currentColor',
      'stroke-width' => '3',
      'stroke-linejoin' => 'round'
    }

    %path{
      d: 'M32 9.5 L38.5 23.5 L53.8 25.3 L42.5 35.7 L45.5 50.8 L32 43.2 L18.5 50.8 L21.5 35.7 L10.2 25.3 L25.5 23.5 Z',
      fill: 'currentColor',
      'stroke-linejoin' => 'round'
    }

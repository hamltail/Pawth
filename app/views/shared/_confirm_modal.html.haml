%dialog#confirm-modal{ data: { controller: 'modal-confirm', modal_confirm_target: 'dialog' },
                       class: 'p-0 border-0 bg-transparent' }
  %div{ class: 'p-6 w-[min(92vw,420px)] bg-surface text-primary rounded-2xl shadow-xl ring-1 ring-default-border' }
    %h3.text-lg.font-semibold.mb-3
      = t('shared.confirm_modal.title')

    %p.text-secondary-text.mb-4{ data: { modal_confirm_target: 'message' } }
      = t('shared.confirm_modal.message')

    %div.hidden.mt-2{ data: { modal_confirm_target: 'textWrap' } }
      %label.block.text-sm.text-secondary-text.mb-1{ for: 'confirm-text' }
        = t('shared.confirm_modal.label')

      %input#confirm-text.w-full.ring-1.ring-default-border.bg-surface.text-primary.rounded-lg.px-3.py-2.outline-none.focus:ring-2.focus:ring-red-500{
        type: 'text',
        autocomplete: 'off',
        data: {
          action: 'input->modal-confirm#validateText',
          modal_confirm_target: 'textInput'
        }
      }

      %p.text-xs.text-muted.mt-1{ data: { modal_confirm_target: 'hint' } }
        = t('shared.confirm_modal.hint')

    .flex.justify-end.gap-3.mt-6
      %button.px-4.py-2.rounded-xl.ring-1.ring-default-border.bg-surface.text-secondary-text.hover:bg-surface-muted.hover:text-primary.transition-colors{
        type: 'button',
        data: {
          action: 'modal-confirm#cancel',
          modal_confirm_target: 'cancelButton'
        }
      }
        = t('shared.confirm_modal.cancel')

      %button.px-4.py-2.rounded-xl.text-white.bg-red-600.hover:bg-red-500.disabled:bg-red-300.disabled:cursor-not-allowed{
        type: 'button',
        disabled: true,
        data: {
          action: 'modal-confirm#ok',
          modal_confirm_target: 'okButton'
        }
      }
        = t('shared.confirm_modal.ok')

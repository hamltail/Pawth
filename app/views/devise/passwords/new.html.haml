%div.flex.items-center.justify-center.min-h-screen.bg-page.px-4
  %div.pawth-surface-card.rounded-2xl.px-8.py-8.max-w-sm.w-full
    %p.mb-2.text-center.text-xs.font-bold.tracking-widest.text-pawth-pink
      RESET PASSWORD

    %div.flex.items-center.justify-center.gap-2.mb-5
      %span.text-3xl.font-extrabold.tracking-tight.text-primary
        Pawth

    %h2.text-2xl.font-bold.mb-6.text-center.text-primary
      = t("devise.shared.forgot_your_password")

    - if resource.errors.any?
      %div.status-error.border.px-4.py-4.rounded.mb-6
        %p= resource.errors.full_messages.first

    = form_for(resource,
               as: resource_name,
               url: password_path(resource_name),
               html: { method: :post }) do |f|

      .mb-6
        = f.label :email,
                  class: "block text-secondary-text mb-2"

        = f.email_field :email,
                        autofocus: true,
                        autocomplete: "email",
                        class: "border border-default-border bg-surface text-primary placeholder:text-muted rounded w-full px-3 py-2"

      .mb-6
        = f.submit t("devise.passwords.send_button"),
                   class: "bg-brand hover:bg-brand-light text-white font-bold py-2 px-4 rounded-full w-full"

    .flex.justify-between.text-sm
      = link_to t("devise.shared.sign_in"),
                new_session_path(resource_name),
                class: "theme-link hover:underline"

      = link_to t("devise.shared.sign_up"),
                new_registration_path(resource_name),
                class: "theme-link hover:underline"

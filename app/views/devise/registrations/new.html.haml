%div.flex.items-center.justify-center.min-h-screen.bg-page.px-4
  %div.pawth-surface-card.rounded-2xl.px-8.py-8.max-w-sm.w-full
    %p.mb-2.text-center.text-xs.font-bold.tracking-widest.text-pawth-pink
      START YOUR PAWTH

    %div.flex.items-center.justify-center.gap-2.mb-5
      %span.text-3xl.font-extrabold.tracking-tight.text-primary
        Pawth

    %h2.text-2xl.font-bold.mb-6.text-center.text-primary
      = t("devise.shared.sign_up")

    - if resource.errors.any?
      %div.status-error.border.px-4.py-4.rounded.mb-6
        %p= t("users.registration.error_message")

    = form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f|
      .mb-4
        = f.label :username,
                  class: "block text-secondary-text mb-2"

        = f.text_field :username,
                       autofocus: true,
                       autocomplete: "username",
                       class: "border border-default-border bg-surface text-primary placeholder:text-muted rounded w-full px-3 py-2"

        - if resource.errors[:username].any?
          %p.field-error.text-sm.mt-1
            = resource.errors.full_messages_for(:username).first

      .mb-4
        = f.label :email,
                  class: "block text-secondary-text mb-2"

        = f.email_field :email,
                        autocomplete: "email",
                        class: "border border-default-border bg-surface text-primary placeholder:text-muted rounded w-full px-3 py-2"

        - if resource.errors[:email].any?
          %p.field-error.text-sm.mt-1
            = resource.errors.full_messages_for(:email).first

      .mb-4
        = f.label :password,
                  class: "block text-secondary-text"

        - if @minimum_password_length
          %em.text-xs.text-muted.mb-1
            = t("devise.shared.password_min_length", length: @minimum_password_length)

        = f.password_field :password,
                           autocomplete: "new-password",
                           class: "border border-default-border bg-surface text-primary placeholder:text-muted rounded w-full px-3 py-2"

        - if resource.errors[:password].any?
          %p.field-error.text-sm.mt-1
            = resource.errors.full_messages_for(:password).first

      .mb-4
        = f.label :password_confirmation,
                  class: "block text-secondary-text mb-2"

        = f.password_field :password_confirmation,
                           autocomplete: "new-password",
                           class: "border border-default-border bg-surface text-primary placeholder:text-muted rounded w-full px-3 py-2"

        - if resource.errors[:password_confirmation].any?
          %p.field-error.text-sm.mt-1
            = resource.errors.full_messages_for(:password_confirmation).first

      .mb-6
        = f.submit t("devise.shared.sign_up"),
                   class: "bg-brand hover:bg-brand-light text-white font-bold py-2 px-4 rounded-full w-full"

    .flex.justify-between.text-sm
      = link_to t("devise.shared.sign_in"),
                new_session_path(resource_name),
                class: "theme-link hover:underline"

      = link_to t("devise.shared.forgot_your_password"),
                new_password_path(resource_name),
                class: "theme-link hover:underline"

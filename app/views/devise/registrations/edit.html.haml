.max-w-5xl.mx-auto
  %div.bg-surface.shadow-md.rounded-lg.px-8.py-8.ring-1.ring-default-border
    %h2.text-2xl.font-bold.text-primary.mb-8.text-center= t("users.edit.title")

    = form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, multipart: true, data: { turbo: "false" } }) do |f|
      - if resource.errors.any?
        %div{ class: 'w-full' }
          %div.status-error.border.px-4.py-4.rounded.mb-6
            %p= t("users.registration.error_message")

      %div{ class: 'mb-4 w-full' }
        = f.label :email, class: "block text-secondary-text mb-2"

        = f.email_field :email,
                        autocomplete: "email",
                        class: "border border-default-border bg-surface text-primary placeholder:text-muted rounded w-full px-3 py-2"

        - if resource.errors[:email].any?
          %p.field-error.text-sm.mt-1= resource.errors.full_messages_for(:email).first

      %div{ class: 'mb-4 w-full' }
        = f.label :password, class: "block text-secondary-text"

        %span.text-xs.text-muted.ml-1
          = t("devise.registrations.edit.password_hint_nochange")

        - if @minimum_password_length
          %span.text-xs.text-muted.ml-1
            = t("devise.shared.password_min_length", length: @minimum_password_length)

        = f.password_field :password,
                           autocomplete: "new-password",
                           class: "border border-default-border bg-surface text-primary placeholder:text-muted rounded w-full px-3 py-2"

        - if resource.errors[:password].any?
          %p.field-error.text-sm.mt-1= resource.errors.full_messages_for(:password).first

      %div{ class: 'mb-4 w-full' }
        = f.label :password_confirmation, class: "block text-secondary-text mb-2"

        = f.password_field :password_confirmation,
                           autocomplete: "new-password",
                           class: "border border-default-border bg-surface text-primary placeholder:text-muted rounded w-full px-3 py-2"

        - if resource.errors[:password_confirmation].any?
          %p.field-error.text-sm.mt-1= resource.errors.full_messages_for(:password_confirmation).first

      %div{ class: 'mb-4 w-full' }
        = f.label :current_password, class: "block text-secondary-text"

        %span.text-xs.text-muted.ml-1
          = t("devise.registrations.edit.current_password_hint")

        = f.password_field :current_password,
                           autocomplete: "current-password",
                           class: "border border-default-border bg-surface text-primary placeholder:text-muted rounded w-full px-3 py-2"

        - if resource.errors[:current_password].any?
          %p.field-error.text-sm.mt-1= resource.errors.full_messages_for(:current_password).first

      .flex.justify-center
        = f.button type: 'submit', class: 'inline-flex items-center gap-2 bg-brand hover:bg-brand-light text-white font-bold py-2 px-8 rounded-full' do
          %svg.w-5.h-5{ fill: 'none', stroke: 'currentColor', viewBox: '0 0 24 24', aria: { hidden: 'true' } }
            %path{ d: 'M20 11a8 8 0 1 0-2.34 5.66', 'stroke-width': '1.5', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
            %path{ d: 'M20 5.5V11h-5.5', 'stroke-width': '1.5', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
          %span= t('users.edit.update')

  %div.bg-surface.shadow-md.rounded-lg.px-8.py-8.mt-24.ring-1.ring-default-border
    %section
      %div{ class: 'w-full' }
        %h2.text-red-600.font-bold.mb-2= t('users.edit.delete_section_title')

        %p.text-sm.text-muted.mb-4
          = t('users.edit.delete_section_description')

        - if flash[:alert].present?
          %p.status-error.border.px-4.py-4.rounded.mb-6{ role: 'alert', 'aria-live': 'polite' }
            = flash[:alert]

        = form_with scope: resource_name, url: registration_path(resource_name),
                    method: :delete, local: true, data: { turbo: 'false' } do |f|
          .mb-4
            = f.label :current_password,
                      t('users.edit.delete_label'),
                      class: 'block text-secondary-text mb-2'

            = f.password_field :current_password,
                               autocomplete: 'current-password',
                               class: 'border border-default-border bg-surface text-primary placeholder:text-muted rounded w-full px-3 py-2'

          .flex.justify-center
            = f.button type: 'submit', class: 'inline-flex items-center gap-2 bg-red-600 hover:bg-red-500 text-white font-bold py-2 px-6 rounded-full' do
              %svg.w-5.h-5{ fill: 'none', stroke: 'currentColor', viewBox: '0 0 24 24', aria: { hidden: 'true' } }
                %path{ d: 'M4.5 6.75h15', 'stroke-width': '1.5', 'stroke-linecap': 'round' }
                %path{ d: 'M9 6.75V4.5h6v2.25', 'stroke-width': '1.5', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
                %path{ d: 'M6.75 6.75 7.5 19.5h9l.75-12.75', 'stroke-width': '1.5', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
                %path{ d: 'M10 10.5v5.25M14 10.5v5.25', 'stroke-width': '1.5', 'stroke-linecap': 'round' }
              %span= t('users.edit.delete_button')

.bg-page.min-h-screen.shadow-md.rounded-lg.px-4.py-8.relative.sm:px-8
  .flex.flex-col.items-center.gap-4.mb-8.sm:grid.sm:grid-cols-3
    %div.hidden.sm:block

    %h1.page-title-glow.text-2xl.font-bold.text-primary.text-center= t('.title')

    .flex.justify-center.sm:justify-end
      #new-post-button
        = render 'activities/new_post_button', posted_today: current_user.posted_today?

  = turbo_frame_tag 'modal'

  %div.mb-8.timeline-search-toggle{ data: { controller: 'collapsible', open: 'false' } }
    .flex.justify-center
      %button.theme-link.inline-flex.items-center.gap-2.rounded-full.border.border-default-border.bg-surface.px-4.py-2.text-sm.font-semibold.transition-colors.hover:bg-surface-muted{ type: 'button', data: { action: 'click->collapsible#toggle' }, aria: { expanded: 'false', controls: 'timeline-search' } }
        %svg.w-4.h-4{ viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width': '1.8', 'stroke-linecap': 'round', 'stroke-linejoin': 'round', aria: { hidden: 'true' } }
          %circle{ cx: '11', cy: '11', r: '7' }
          %path{ d: 'm20 20-3.5-3.5' }
        %span= t('.open_search')

    #timeline-search.timeline-search-panel
      = form_with url: daily_posts_path, method: :get, local: true, class: 'mx-auto flex max-w-2xl flex-wrap justify-center gap-2 rounded-2xl border border-default-border bg-surface p-4', data: { controller: 'search-filters' } do |f|
        %div{ class: 'relative w-full sm:flex-1 sm:min-w-64' }
          = label_tag :q, t('.search_placeholder'), class: 'sr-only'
          = f.text_field :q, placeholder: t('.search_placeholder'), value: params[:q], class: 'h-12 w-full rounded-md border border-default-border bg-page px-4 pr-10 text-primary placeholder:text-muted', data: { search_filters_target: 'field', action: 'input->search-filters#update' }
          %button{ type: 'button', class: 'hidden absolute right-2 top-1/2 -translate-y-1/2 theme-link h-7 w-7 items-center justify-center rounded-full hover:bg-surface-muted', aria: { label: 'キーワードをクリア' }, data: { search_filters_target: 'clear', action: 'click->search-filters#clear', field_index: 0 } }
            %svg.h-4.w-4{ viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width': '1.8', 'stroke-linecap': 'round', aria: { hidden: 'true' } }
              %path{ d: 'M6 6l12 12M18 6 6 18' }

        %div.relative
          = label_tag :year, t('.year_prompt'), class: 'sr-only'
          = f.select :year, options_for_select((2026..Date.current.year).to_a.reverse, params[:year]), { prompt: t('.year_prompt') }, class: 'h-12 rounded-md border border-default-border bg-page pl-3 pr-14 text-primary', data: { search_filters_target: 'field', action: 'change->search-filters#update' }
          %button{ type: 'button', class: 'hidden absolute right-7 top-1/2 -translate-y-1/2 theme-link h-7 w-7 items-center justify-center rounded-full hover:bg-surface-muted', aria: { label: '年をクリア' }, data: { search_filters_target: 'clear', action: 'click->search-filters#clear', field_index: 1 } }
            %svg.h-4.w-4{ viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width': '1.8', 'stroke-linecap': 'round', aria: { hidden: 'true' } }
              %path{ d: 'M6 6l12 12M18 6 6 18' }

        %div.relative
          = label_tag :month, t('.month_prompt'), class: 'sr-only'
          = f.select :month, options_for_select((1..12).to_a.map { |m| [m, m] }, params[:month]), { prompt: t('.month_prompt') }, class: 'h-12 rounded-md border border-default-border bg-page pl-3 pr-14 text-primary', data: { search_filters_target: 'field', action: 'change->search-filters#update' }
          %button{ type: 'button', class: 'hidden absolute right-7 top-1/2 -translate-y-1/2 theme-link h-7 w-7 items-center justify-center rounded-full hover:bg-surface-muted', aria: { label: '月をクリア' }, data: { search_filters_target: 'clear', action: 'click->search-filters#clear', field_index: 2 } }
            %svg.h-4.w-4{ viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width': '1.8', 'stroke-linecap': 'round', aria: { hidden: 'true' } }
              %path{ d: 'M6 6l12 12M18 6 6 18' }

        = f.submit t('.submit_search'), class: 'h-12 min-w-20 rounded-full bg-brand px-6 font-semibold text-white transition-colors hover:bg-brand-light cursor-pointer'

  - if @daily_posts.any?
    .mx-auto.max-w-4xl{ data: { controller: 'infinite-scroll' } }
      %ul.posts#posts{ data: { infinite_scroll_target: 'posts' } }
        = render 'timeline_posts', posts: @daily_posts, previous_month: nil

      - if @pagy.next
        #infinite-scroll-sentinel.h-4{ data: { infinite_scroll_target: 'sentinel', next_url: daily_posts_path(request.query_parameters.merge(page: @pagy.next)) } }

    %button.scroll-to-top-button.theme-link.fixed.bottom-6.right-6.z-30.inline-flex.h-12.w-12.translate-y-2.items-center.justify-center.rounded-full.border.border-default-border.bg-surface.opacity-0.pointer-events-none.transition-all.duration-300.ease-out.hover:-translate-y-1.hover:bg-surface-muted.md:bottom-8.md:right-8{
      type: 'button',
      data: {
        controller: 'scroll-to-top',
        action: 'click->scroll-to-top#scroll'
      },
      aria: {
        label: 'トップへ戻る'
      }
    }
      %svg.h-6.w-6{
        viewBox: '0 0 24 24',
        fill: 'none',
        stroke: 'currentColor',
        'stroke-width': '1.8',
        'stroke-linecap': 'round',
        'stroke-linejoin': 'round',
        aria: { hidden: 'true' }
      }
        %path{ d: 'm6 15 6-6 6 6' }

- calendar_active = controller_path == 'activities'
- timeline_active = controller_path == 'daily_posts'
- profile_active = controller_path == 'profiles'
- account_active = controller_path == 'users/registrations'
- settings_active = profile_active || account_active
- sidebar_item_classes = 'theme-link -mx-3 rounded-xl px-3 py-2 transition-colors duration-150 hover:bg-brand/15 focus-visible:bg-brand/15'

%aside.bg-sidebar.shadow-md.w-64.h-screen.px-6.py-6.flex.flex-col.fixed.z-60.transform.transition-transform.duration-200.-translate-x-full.lg:translate-x-0{
  id: 'sidebar',
  data: { menu_target: 'sidebar' }
}
  %div.daily-post-scroll.min-h-0.flex-1.-mx-6.px-6.overflow-x-hidden.overflow-y-auto.pb-20
    .flex.items-center.justify-between.mb-8
      .text-lg.font-bold
        = link_to t('layout.sidebar.app_name'),
                  root_path,
                  class: 'sidebar-brand'

      .relative
        %button.theme-link.sidebar-close-button.grid.size-8.place-items-center.rounded-lg.hover:bg-surface-muted.hover:scale-110.hover:rotate-6.focus-visible:scale-110.focus-visible:rotate-6.transition-transform.duration-200{
          type: 'button',
          data: { action: 'click->menu#close' },
          aria: { label: t('layout.sidebar.close'), controls: 'sidebar' }
        }
          = render 'shared/sidebar_icons/close'

        %span.sidebar-menu-tooltip.sidebar-close-tooltip{ aria: { hidden: 'true' } }
          = t('layout.sidebar.toggle_tooltip')

    %nav.flex.flex-col.space-y-2
      = link_to root_path,
                class: "#{sidebar_item_classes} flex items-center gap-3 font-medium#{' bg-brand/15' if calendar_active}",
                aria: { current: ('page' if calendar_active) } do
        = render 'shared/sidebar_icons/calendar'

        %span= t('layout.sidebar.calendar')

      = link_to daily_posts_path,
                class: "#{sidebar_item_classes} flex items-center gap-3 font-medium#{' bg-brand/15' if timeline_active}",
                aria: { current: ('page' if timeline_active) } do
        = render 'shared/sidebar_icons/timeline'

        %span= t('layout.sidebar.daily_posts')

      .sidebar-settings.-mx-3{
        data: {
          controller: 'collapsible',
          open: 'false',
          collapsible_storage_key: 'sidebar-settings-open'
        }
      }
        %button.theme-link.w-full.flex.items-center.justify-between.font-medium.rounded-xl.px-3.py-2.transition-colors.duration-150{
          class: "hover:bg-brand/15 focus-visible:bg-brand/15#{' bg-brand/15' if settings_active}",
          type: 'button',
          data: { action: 'click->collapsible#toggle' },
          aria: {
            expanded: 'false',
            controls: 'settings-submenu'
          }
        }
          .flex.items-center.gap-3
            = render 'shared/sidebar_icons/settings', icon_class: 'w-5 h-5 shrink-0'

            %span= t('layout.sidebar.settings')

          %span.sidebar-settings-icon.inline-flex{ data: { collapsible_target: 'animated' }, aria: { hidden: 'true' } }
            = render 'shared/sidebar_icons/settings_chevron'

        %ul.sidebar-settings-panel.mt-2.pl-7.space-y-2#settings-submenu
          %li
            = link_to edit_profile_path,
                      class: "#{sidebar_item_classes} flex items-center gap-2 font-medium#{' bg-brand/15' if profile_active}",
                      aria: { current: ('page' if profile_active) } do
              = render 'shared/sidebar_icons/profile'

              %span= t('layout.sidebar.profile_settings')

          %li
            = link_to edit_user_registration_path,
                      class: "#{sidebar_item_classes} flex items-center gap-2 font-medium#{' bg-brand/15' if account_active}",
                      aria: { current: ('page' if account_active) } do
              = render 'shared/sidebar_icons/settings', icon_class: 'w-5 h-5 shrink-0'

              %span= t('layout.sidebar.account_settings')

      %div.relative.inline-flex.pt-4{ data: { controller: 'theme' } }
        %button.theme-link.grid.size-9.place-items-center.rounded-full.border.border-default-border.bg-sidebar.hover:bg-surface-muted.transition-colors{
          type: 'button',
          title: 'テーマを変更',
          data: {
            action: 'click->theme#toggle',
            theme_target: 'trigger'
          },
          aria: {
            label: 'テーマを変更',
            expanded: 'false',
            controls: 'theme-options'
          }
        }
          %span.block.size-4{
            data: { theme_target: 'triggerIcon' },
            aria: { hidden: 'true' }
          }

        %div#theme-options.hidden.absolute.top-full.left-0.z-70.mt-2.shrink-0.gap-1.rounded-full.border.border-default-border.bg-surface.p-1.shadow-lg{
          role: 'group',
          data: { theme_target: 'panel' },
          aria: { label: 'テーマを変更' }
        }
          %button.grid.size-8.place-items-center.rounded-full.text-muted.hover:bg-surface-muted.transition-colors{
            type: 'button',
            aria: {
              label: 'ライト',
              pressed: 'false'
            },
            title: 'ライト',
            data: {
              action: 'click->theme#select',
              theme: 'light',
              theme_target: 'option'
            }
          }
            %span.block.size-4
              = render 'shared/sidebar_icons/theme_light'

          %button.grid.size-8.place-items-center.rounded-full.text-muted.hover:bg-surface-muted.transition-colors{
            type: 'button',
            aria: {
              label: 'ダーク',
              pressed: 'false'
            },
            title: 'ダーク',
            data: {
              action: 'click->theme#select',
              theme: 'dark',
              theme_target: 'option'
            }
          }
            %span.block.size-4
              = render 'shared/sidebar_icons/theme_dark'

          %button.grid.size-8.place-items-center.rounded-full.text-muted.hover:bg-surface-muted.transition-colors{
            type: 'button',
            aria: {
              label: 'システム',
              pressed: 'false'
            },
            title: 'システム',
            data: {
              action: 'click->theme#select',
              theme: 'system',
              theme_target: 'option'
            }
          }
            %span.block.size-4
              = render 'shared/sidebar_icons/theme_system'

  %div.mt-auto.shrink-0.pt-4
    = link_to destroy_user_session_path,
        data: { turbo_method: :delete },
        class: 'sidebar-no-close danger-link flex items-center gap-3 font-medium' do
      = render 'shared/sidebar_icons/logout'

      %span= t('layout.sidebar.logout')

%aside.bg-white.shadow-md.w-64.h-screen.px-6.py-6.flex.flex-col.fixed.z-60.transform.transition-transform.duration-200.-translate-x-full.md:translate-x-0.md:flex{
  id: 'sidebar',
  data: { menu_target: 'sidebar' }
}
  %div
    .text-lg.font-bold.text-brand.mb-8
      = link_to t('layout.sidebar.app_name'), root_path

    %nav.flex.flex-col.space-y-6
      = link_to root_path, class: 'flex items-center gap-3 text-gray-700 hover:text-brand-light font-medium' do
        %svg.w-5.h-5.shrink-0{ fill: 'none', stroke: 'currentColor', viewBox: '0 0 24 24', aria: { hidden: 'true' } }
          %ellipse{ cx: '12', cy: '16.5', rx: '4.5', ry: '3.75', 'stroke-width': '1.5' }
          %ellipse{ cx: '6.75', cy: '10', rx: '1.75', ry: '2.25', transform: 'rotate(-25 6.75 10)', 'stroke-width': '1.5' }
          %ellipse{ cx: '10.25', cy: '6.75', rx: '1.75', ry: '2.25', transform: 'rotate(-8 10.25 6.75)', 'stroke-width': '1.5' }
          %ellipse{ cx: '13.75', cy: '6.75', rx: '1.75', ry: '2.25', transform: 'rotate(8 13.75 6.75)', 'stroke-width': '1.5' }
          %ellipse{ cx: '17.25', cy: '10', rx: '1.75', ry: '2.25', transform: 'rotate(25 17.25 10)', 'stroke-width': '1.5' }
        %span= t('layout.sidebar.calendar')

      = link_to daily_posts_path, class: 'flex items-center gap-3 text-gray-700 hover:text-brand-light font-medium' do
        %svg.w-5.h-5.shrink-0{ fill: 'none', stroke: 'currentColor', viewBox: '0 0 24 24', aria: { hidden: 'true' } }
          %path{ d: 'M4.5 7.5h15', 'stroke-width': '1.5', 'stroke-linecap': 'round' }
          %path{ d: 'M6.75 4.5h10.5A2.25 2.25 0 0 1 19.5 6.75v12A2.25 2.25 0 0 1 17.25 21H6.75A2.25 2.25 0 0 1 4.5 18.75v-12A2.25 2.25 0 0 1 6.75 4.5Z', 'stroke-width': '1.5', 'stroke-linejoin': 'round' }
          %path{ d: 'M9 11.25h6M9 15h4.5', 'stroke-width': '1.5', 'stroke-linecap': 'round' }
        %span= t('layout.sidebar.daily_posts')

      %div{ data: { controller: 'collapsible', open: 'false' } }
        %button.w-full.flex.items-center.justify-between.text-gray-700.font-medium.hover:text-brand-light{
          type: 'button',
          data: { action: 'click->collapsible#toggle' },
          aria: { expanded: 'false', controls: 'settings-submenu' }
        }
          .flex.items-center.gap-3
            %svg.w-5.h-5.shrink-0{ fill: 'none', stroke: 'currentColor', viewBox: '0 0 24 24', aria: { hidden: 'true' } }
              %path{ d: 'M9.6 3.75h4.8l.55 2.05a7 7 0 0 1 1.47.85l2.04-.58 2.4 4.16-1.5 1.48a7.3 7.3 0 0 1 0 1.7l1.5 1.48-2.4 4.16-2.04-.58a7 7 0 0 1-1.47.85l-.55 2.05H9.6l-.55-2.05a7 7 0 0 1-1.47-.85l-2.04.58-2.4-4.16 1.5-1.48a7.3 7.3 0 0 1 0-1.7l-1.5-1.48 2.4-4.16 2.04.58a7 7 0 0 1 1.47-.85l.55-2.05Z', 'stroke-width': '1.5', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
              %circle{ cx: '12', cy: '12.56', r: '2.3', 'stroke-width': '1.5' }
            %span= t('layout.sidebar.settings')

          %span.transition-transform.duration-200{ data: { collapsible_target: 'icon' } } ▶

        %ul.mt-2.pl-4.space-y-2.hidden#settings-submenu{ data: { collapsible_target: 'panel' } }
          %li
            = link_to edit_profile_path, class: 'flex items-center gap-2 text-gray-700 hover:text-brand-light font-medium' do
              %svg.w-4.h-4.shrink-0{ fill: 'none', stroke: 'currentColor', viewBox: '0 0 24 24', aria: { hidden: 'true' } }
                %circle{ cx: '12', cy: '8', r: '3', 'stroke-width': '1.5' }
                %path{ d: 'M6.5 19c.8-3.1 2.65-4.75 5.5-4.75S16.7 15.9 17.5 19', 'stroke-width': '1.5', 'stroke-linecap': 'round' }
              %span= t('layout.sidebar.profile_settings')

          %li
            = link_to edit_user_registration_path, class: 'flex items-center gap-2 text-gray-700 hover:text-brand-light font-medium' do
              %svg.w-4.h-4.shrink-0{ fill: 'none', stroke: 'currentColor', viewBox: '0 0 24 24', aria: { hidden: 'true' } }
                %path{ d: 'M9.6 3.75h4.8l.55 2.05a7 7 0 0 1 1.47.85l2.04-.58 2.4 4.16-1.5 1.48a7.3 7.3 0 0 1 0 1.7l1.5 1.48-2.4 4.16-2.04-.58a7 7 0 0 1-1.47.85l-.55 2.05H9.6l-.55-2.05a7 7 0 0 1-1.47-.85l-2.04.58-2.4-4.16 1.5-1.48a7.3 7.3 0 0 1 0-1.7l-1.5-1.48 2.4-4.16 2.04.58a7 7 0 0 1 1.47-.85l.55-2.05Z', 'stroke-width': '1.5', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
                %circle{ cx: '12', cy: '12.56', r: '2.3', 'stroke-width': '1.5' }
              %span= t('layout.sidebar.account_settings')

      = link_to destroy_user_session_path,
          data: { turbo_method: :delete },
          class: 'sidebar-no-close flex items-center gap-3 text-red-600 font-medium' do
        %svg.w-5.h-5.shrink-0{ fill: 'none', stroke: 'currentColor', viewBox: '0 0 24 24', aria: { hidden: 'true' } }
          %path{ d: 'M10 5H6.75A1.75 1.75 0 0 0 5 6.75v10.5A1.75 1.75 0 0 0 6.75 19H10', 'stroke-width': '1.5', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
          %path{ d: 'M13 8.5 16.5 12 13 15.5M8.5 12h8', 'stroke-width': '1.5', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
        %span= t('layout.sidebar.logout')

!!!
%html{ lang: (I18n.locale || I18n.default_locale).to_s }
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title= content_for(:title) || "Pawth"
    %meta{:content => "width=device-width,initial-scale=1", :name => "viewport"}/
    %meta{:content => "yes", :name => "apple-mobile-web-app-capable"}/
    %meta{:content => "yes", :name => "mobile-web-app-capable"}/
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head

    %link{
      rel: "icon",
      type: "image/svg+xml",
      href: asset_path("pawth.svg")
    }/

    %link{
      href: asset_path("pawth.svg"),
      rel: "apple-touch-icon"
    }/

    %script{ nonce: content_security_policy_nonce }
      :plain
        (() => {
          const theme = localStorage.getItem('pawth-theme') || 'system';

          const resolvedTheme =
            theme === 'system'
              ? window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light'
              : theme;

          document.documentElement.dataset.theme = resolvedTheme;
          document.documentElement.dataset.themePreference = theme;
        })();

    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags

  %body
    %div.flex.min-h-screen.bg-page{
      data: (user_signed_in? ? { controller: 'menu' } : {})
    }
      - if user_signed_in?
        %button.hidden.fixed.top-8.left-8.z-50.grid.size-10.place-items-center.bg-surface.rounded-lg.ring-1.ring-default-border.sidebar-menu-button{
          id: 'menu-button',
          type: 'button',
          data: {
            action: 'click->menu#open',
            menu_target: 'button'
          },
          aria: {
            label: t('layout.sidebar.open'),
            controls: 'sidebar',
            expanded: 'false'
          }
        }
          %span.sidebar-menu-paw-wrapper{ aria: { hidden: 'true' } }
            %span.sidebar-menu-paw
            %svg.sidebar-menu-toggle-icon.w-6.h-6{
              fill: 'none',
              stroke: 'currentColor',
              viewBox: '0 0 24 24',
              'stroke-width': '1.7',
              'stroke-linecap': 'round',
              'stroke-linejoin': 'round',
              aria: { hidden: 'true' }
            }
              %rect{ x: '3', y: '3', width: '18', height: '18', rx: '2.5' }
              %path{ d: 'M9 3v18' }
              %path{ d: 'm14 9 3 3-3 3' }

          %span.sidebar-menu-tooltip{ aria: { hidden: 'true' } }
            = t('layout.sidebar.toggle_tooltip')

        = render 'layouts/sidebar'

      - else
        %header.fixed.top-8.left-8.z-40
          = link_to new_user_session_path,
                    class: 'public-brand inline-flex items-center gap-1',
                    aria: { label: 'Pawth ログインへ' } do

            %span.text-2xl.font-extrabold.tracking-tight
              Pawth

            %span.public-brand-paw-wrapper{
              aria: { hidden: 'true' }
            }
              %span.public-brand-paw

          %p.hidden.md:block.mt-1.text-xs.text-muted
            日々の足あとを描く、1日1投稿の小さな日記アプリ

      - main_class = user_signed_in? ? "ml-0 lg:ml-64 flex-1 min-h-screen bg-page transition-[margin-left] duration-200" : "flex-1 min-h-screen bg-page"
      - container_class = content_for?(:wide_calendar_layout) ? "mx-auto w-full max-w-[92rem] min-h-screen" : "mx-auto w-full max-w-280 min-h-screen"

      %main{
        class: main_class,
        data: (user_signed_in? ? { menu_target: 'main' } : {})
      }
        %div{ class: container_class }
          = yield

    = render 'shared/confirm_modal'

!!!
%html{ lang: (I18n.locale || I18n.default_locale).to_s }
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title= content_for(:title) || "Pawth"
    %meta{:content => "width=device-width,initial-scale=1", :name => "viewport"}/
    %meta{:content => "yes", :name => "apple-mobile-web-app-capable"}/
    %meta{:content => "yes", :name => "mobile-web-app-capable"}/
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    %link{ rel: "icon", type: "image/png", href: asset_path("pawth.png") }/
    %link{ href: asset_path("pawth.png"), rel: "apple-touch-icon" }/
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags

  %body
    %div.flex.min-h-screen.bg-white{ data: { controller: 'menu' } }
      - if user_signed_in?
        %button.md:hidden.fixed.top-8.left-8.z-50.bg-white.p-2.rounded-lg.shadow-lg{
          id: 'menu-button',
          data: { action: 'click->menu#toggle', menu_target: 'button' },
          aria: { label: 'メニュー', controls: 'sidebar', expanded: 'false' }
        }
          %svg.w-6.h-6{ fill: "none", stroke: "currentColor", viewBox: "0 0 24 24", aria: { hidden: 'true' } }
            %path{ d: "M4 6h16M4 12h16M4 18h16", stroke: "#1f2937", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round" }

        = render 'layouts/sidebar'

      - else
        %header.fixed.top-8.left-8.z-40
          = link_to new_user_session_path, class: "inline-flex items-center gap-2 text-gray-900", aria: { label: "Pawth ログインへ" } do
            %span.text-2xl.font-extrabold.tracking-tight
              Pawth
            %span.text-2xl{ aria: { hidden: 'true' } }
              🐾

          %p.hidden.md:block.mt-1.text-xs.text-gray-500
            日々の足あとを描く、1日1投稿の小さな日記アプリ

      - main_class = user_signed_in? ? "ml-0 md:ml-64 flex-1 min-h-screen bg-white" : "flex-1 min-h-screen"
      - container_class = user_signed_in? ? "mx-auto w-full max-w-360 min-h-screen" : "mx-auto w-full max-w-280 min-h-screen"

      %main{ class: main_class }
        %div{ class: container_class }
          = yield

    = render 'shared/confirm_modal'
